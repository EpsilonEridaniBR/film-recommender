# Copy to backend/.env for local development.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
# Local development only: "*" lets your phone reach Django over the network.
ALLOWED_HOSTS=*
DATABASE_URL=postgres://film:film@localhost:5432/film

# Audio storage (DigitalOcean Spaces in production). Leave the bucket empty
# to store audio on local disk in development.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

TMDB_API_KEY=
APPLE_BUNDLE_ID=
# Sign in with Apple key, for revoking tokens on account deletion.
# APPLE_PRIVATE_KEY is the .p8 file contents with newlines written as \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# With DEBUG on, the app can sign in with just a display name (no Apple).
# Set to False to turn that off. It's always off when DEBUG is off.
DEV_SIGN_IN=True
SENTRY_DSN=
